# 复制为 .env 后填写。真实值绝不入库。
# NapCat WebUI 令牌（首次部署自己设一个强口令）
WEBUI_TOKEN=change-me
# 登录的 QQ 号
QQ_ACCOUNT=100000000

# 端口发布：默认只绑 127.0.0.1（compose.yml）。
# 要走内网/mesh，再叠加 compose.mesh.yml，并把 MESH_IP 填成本机 mesh 地址：
#   docker compose -f compose.yml -f compose.mesh.yml up -d
# 注意：MESH_IP 不能是 127.0.0.1（会与回环绑定冲突，Docker 报 port already allocated）。
MESH_IP=

# 群操作台额外允许的 Host（同源之外的兜底，逗号分隔；留空用插件默认值）
JOINER_ALLOW_HOSTS=qq.example.com
# 反向代理来源地址：只有来自这些地址的请求才信任 X-Forwarded-For / CF-Connecting-IP
JOINER_TRUSTED_PROXIES=127.0.0.1,::1

# 内核排队：队列上限 / 单次排队最长等待（毫秒）
JOINER_KERNEL_QUEUE_MAX=8
JOINER_KERNEL_WAIT_MS=10000
# 单次内核调用超时（毫秒；0 = 按调用类型默认 15s/20s）
JOINER_KERNEL_TIMEOUT_MS=0
# 内核并发上限（默认 2）
JOINER_KERNEL_MAX=2
# 僵尸槽位回收（毫秒；0 = 单次超时的 5 倍且不少于 60s）
# 内核调用既不返回也不报错时，超过这个时间就强制回收槽位，避免插件永久 503。
JOINER_KERNEL_ZOMBIE_MS=0
# 鉴权失败锁定窗口（毫秒；默认 10 分钟）
JOINER_AUTH_FAIL_WINDOW_MS=600000

# sk-invite-accept.py 的目标群号（留空则不做任何动作）
TARGET_GROUP=
