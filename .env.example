# 复制为 .env 后填写。真实值绝不入库。
# NapCat WebUI 令牌（首次部署自己设一个强口令）
WEBUI_TOKEN=change-me
# 登录的 QQ 号
QQ_ACCOUNT=100000000
# 端口发布地址：只用本机就留 127.0.0.1；要经内网/mesh 访问填对应网卡地址
MESH_IP=127.0.0.1
# 群操作台额外允许的 Host（同源之外的兜底，逗号分隔）
JOINER_ALLOW_HOSTS=qq.example.com
# sk-join-group / sk-invite-accept.py 的目标群号（留空则不做任何动作）
TARGET_GROUP=
